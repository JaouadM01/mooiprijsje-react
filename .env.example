# Laat deze waarden leeg om de site met voorbeelddata te draaien (demo-modus).
# Vul ze in om producten en winkelwagen uit je Shopify-winkel te halen.

# Je myshopify-domein, zonder https://  (bijv. mooiprijsje.myshopify.com)
VITE_SHOPIFY_STORE_DOMAIN=

# Storefront API access token (Shopify admin > Apps > Develop apps > Storefront API).
# Dit token is bedoeld voor gebruik in de browser en mag publiek zijn.
# NOOIT een Admin-token (shpat_...) invullen: alles in VITE_-variabelen komt openbaar in de website.
# Geef het token alleen de scopes uit README.md.
VITE_SHOPIFY_STOREFRONT_TOKEN=

# Storefront API-versie
VITE_SHOPIFY_API_VERSION=2025-07

# Zet op true om "Laag op voorraad: nog X stuks" te tonen. Geef je Storefront-token dan ook
# de scope unauthenticated_read_product_inventory, anders faalt de productpagina.
VITE_SHOPIFY_READ_INVENTORY=false

# Nieuwsbrief- en contactformulier. Shopify heeft hier geen publieke API voor,
# dus wijs ze naar een eigen endpoint of een dienst als Klaviyo/Formspree.
# Verwacht: POST met JSON, 2xx = gelukt.
VITE_NEWSLETTER_ENDPOINT=
VITE_CONTACT_ENDPOINT=
